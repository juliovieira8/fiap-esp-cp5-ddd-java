<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.com.fiap.bank</groupId>
        <artifactId>fiap-bank-core-bancario</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>fiap-bank-core-bancario-presentation</artifactId>
    <name>FIAP Bank - Core Bancario :: presentation</name>
    <description>Ponto de entrada RESTful (Spring Boot), controllers e tratamento global de excecoes</description>

    <dependencies>
        <!-- presentation enxerga somente application (domain/infrastructure chegam apenas em runtime) -->
        <dependency>
            <groupId>br.com.fiap.bank</groupId>
            <artifactId>fiap-bank-core-bancario-application</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- presentation nao pode declarar acesso direto a domain ou infrastructure -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-hierarquia-presentation</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>false</searchTransitive>
                                    <message>Violacao de hierarquia: presentation so pode depender diretamente de application (nunca de domain ou infrastructure).</message>
                                    <excludes>
                                        <exclude>br.com.fiap.bank:fiap-bank-core-bancario-domain</exclude>
                                        <exclude>br.com.fiap.bank:fiap-bank-core-bancario-infrastructure</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
